# ==============================================================================
# Environment Configuration — Secure Expiring NoteTaker POC
# ==============================================================================

# PostgreSQL Connection String (Neon PostgreSQL with connection pooling)
DATABASE_URL="postgresql://user:password@ep-pooler.neon.tech/neondb?sslmode=require"

# Optional Redis Instance for High-Speed Locking, Rate-Limiting & Caching
# (If not provided, the system automatically falls back to PostgreSQL atomic queries)
REDIS_URL="redis://default:password@your-redis-host:6379"

# Cryptographic Authentication Secrets for Dual-Token Architecture
JWT_SECRET="your-256-bit-jwt-access-secret-minimum-32-characters"
JWT_REFRESH_SECRET="your-256-bit-jwt-refresh-secret-minimum-32-characters"

# Optional Google OAuth 2.0 Credentials (leave dummy to use local OAuth simulator)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
